# Kết nối "Đăng nhập bằng Chấm Công Trạm" (Firebase project chamcongtram — Web app config).
# Sao chép sang .env.local và điền giá trị; để trống thì nút Chấm Công sẽ bị ẩn.
# Lưu ý: tên miền của web POS phải nằm trong chamcongtram → Authentication → Settings → Authorized domains.
NEXT_PUBLIC_CHAMCONG_API_KEY=
NEXT_PUBLIC_CHAMCONG_AUTH_DOMAIN=
NEXT_PUBLIC_CHAMCONG_PROJECT_ID=
NEXT_PUBLIC_CHAMCONG_APP_ID=
